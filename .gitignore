# Dependencies
node_modules/

# Build output
app/dist/
app/src-tauri/target/
app/src-tauri/gen/schemas/

# Rust
target/

# Secrets — never commit a real env file. .env.example is fine.
.env
.env.local

# Scratch state written by the agent's test, which cleans up after itself unless
# it is killed mid-run.
infra/agent/*.test-state.json

# Python, from compile-checking the Laya service.
__pycache__/
*.pyc

# Vitest writes a timestamped copy of the config beside the real one when a run
# is interrupted. Four of them had been committed before anyone noticed — their
# contents embed an absolute path from whatever machine produced them.
app/vitest.config.ts.timestamp-*.mjs

# OS / editor
.DS_Store
Thumbs.db
*.local
