use serde::{Deserialize, Serialize};
use std::collections::HashMap;

/* ── HTTP proxy command ─────────────────────────────────────────────────── */

/// Incoming shape from the TypeScript caller (camelCase via serde rename_all).
#[derive(Deserialize)]
#[serde(rename_all = "camelCase")]
struct HttpRequest {
    url: String,
    method: String,
    headers: HashMap<String, String>,
    body: Option<String>,
}

/// Outgoing shape — camelCase so the JS side receives `bodyBytes`, `contentType`, etc.
#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct HttpResponse {
    status: u16,
    status_text: String,
    /// Raw response bytes. The JS side converts this `number[]` to `Uint8Array`.
    body_bytes: Vec<u8>,
    content_type: Option<String>,
}

/// Issues an HTTP request from Rust, bypassing the webview's CORS enforcement.
///
/// Called by `nativeFetch` in `native/bridge.ts`. All outbound fetches in live
/// mode flow through here so that Immich and Nextcloud requests are not blocked
/// by the browser's same-origin policy.
#[tauri::command]
async fn http_request(req: HttpRequest) -> Result<HttpResponse, String> {
    let client = reqwest::Client::builder()
        .timeout(std::time::Duration::from_secs(10))
        .build()
        .map_err(|e| format!("Failed to build HTTP client: {e}"))?;

    let method = reqwest::Method::from_bytes(req.method.as_bytes())
        .map_err(|e| format!("Invalid HTTP method '{}': {e}", req.method))?;

    let mut builder = client.request(method, &req.url);
    for (k, v) in &req.headers {
        builder = builder.header(k.as_str(), v.as_str());
    }
    if let Some(body) = req.body {
        builder = builder.body(body);
    }

    let resp = builder
        .send()
        .await
        .map_err(|e| format!("HTTP request failed: {e}"))?;

    let status = resp.status().as_u16();
    let status_text = resp
        .status()
        .canonical_reason()
        .unwrap_or("")
        .to_string();
    let content_type = resp
        .headers()
        .get(reqwest::header::CONTENT_TYPE)
        .and_then(|v| v.to_str().ok())
        .map(|s| s.split(';').next().unwrap_or(s).trim().to_string());

    let body_bytes = resp
        .bytes()
        .await
        .map_err(|e| format!("Failed to read response body: {e}"))?
        .to_vec();

    Ok(HttpResponse {
        status,
        status_text,
        body_bytes,
        content_type,
    })
}

/* ── Keychain commands ──────────────────────────────────────────────────── */

const KEYCHAIN_SERVICE: &str = "filesynapse";

#[tauri::command]
fn store_credential(account: String, value: Option<String>) -> Result<(), String> {
    let entry = keyring::Entry::new(KEYCHAIN_SERVICE, &account)
        .map_err(|e| format!("Keychain entry error: {e}"))?;
    match value {
        Some(v) if !v.is_empty() => entry
            .set_password(&v)
            .map_err(|e| format!("Failed to store '{account}': {e}")),
        _ => {
            // Empty or absent value → delete. Ignore NoEntry errors.
            match entry.delete_credential() {
                Ok(()) | Err(keyring::Error::NoEntry) => Ok(()),
                Err(e) => Err(format!("Failed to delete '{account}': {e}")),
            }
        }
    }
}

/// Retrieves a credential from the OS keychain.
///
/// Returns `null` when no entry exists rather than an error, so the caller
/// can treat absence and non-existence uniformly.
#[tauri::command]
fn get_credential(account: String) -> Result<Option<String>, String> {
    let entry = keyring::Entry::new(KEYCHAIN_SERVICE, &account)
        .map_err(|e| format!("Keychain entry error: {e}"))?;
    match entry.get_password() {
        Ok(v) => Ok(Some(v)),
        Err(keyring::Error::NoEntry) => Ok(None),
        Err(e) => Err(format!("Failed to retrieve '{account}': {e}")),
    }
}

/* ── App entry point ────────────────────────────────────────────────────── */

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        // Backs `native/bridge.ts`: folder dialogs and "open in system explorer".
        .plugin(tauri_plugin_dialog::init())
        .plugin(tauri_plugin_opener::init())
        // The http plugin is registered so its Rust-side reqwest client is
        // available (and its capability scope validated), even though requests
        // go through our own `http_request` command rather than the plugin's
        // built-in JS fetch wrapper.
        .plugin(tauri_plugin_http::init())
        .invoke_handler(tauri::generate_handler![
            http_request,
            store_credential,
            get_credential,
        ])
        .run(tauri::generate_context!())
        .expect("error while running FileSynapse");
}
