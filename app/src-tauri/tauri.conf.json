{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSynapse",
  "version": "0.1.0",
  "identifier": "app.filesynapse.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileSynapse",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FileSynapse",
    "copyright": "© 2026 FileSynapse",
    "category": "Utility",
    "shortDescription": "Server status, photos and files for a self-hosted NAS.",
    "longDescription": "The desktop client for a self-hosted NAS. It watches the server from the tray — did the backup run, how full is the disk, are the services up — and browses the photo and file libraries when you want them. It is a viewer, not an uploader: camera upload stays with Immich's own app, and file sync with Nextcloud's.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "FileSynapse",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
