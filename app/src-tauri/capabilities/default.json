{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the FileSynapse window needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-path",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:2283/*" },
        { "url": "http://*:8080/*" },
        { "url": "http://*:8787/*" },
        { "url": "https://*:2283/*" },
        { "url": "https://*:8080/*" },
        { "url": "https://*:8787/*" }
      ]
    }
  ]
}
