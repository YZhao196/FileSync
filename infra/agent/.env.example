# Copy to .env and fill in. Never commit .env.
#
# Generate a token with:  openssl rand -hex 32
# Paste the same value into the desktop app under Settings → Data source.
AGENT_TOKEN=__CHANGE_ME_AGENT__

# Everything below has a working default and only needs setting on an unusual
# layout. See README.md for the full table.

# AGENT_PORT=8787
# AGENT_PHOTOS_PATH=/srv/photos
# AGENT_CLOUD_PATH=/srv/cloud
# AGENT_SERVICES=immich,nextcloud,mariadb,redis
# RESTIC_REPOSITORY=b2:espnas-backup:/
# The backup timer's verdict file. Read when it exists, so lastRunOk is a fact
# rather than an inference — see "Where lastRunOk comes from" in README.md.
# AGENT_BACKUP_STATUS=/var/lib/filesynapse/last-backup

# ── Optional decision pipeline ──────────────────────────────────────────────
#
# Off unless you set it up. Leave everything below unset and the four
# /api/decisions routes answer "unavailable" without contacting anything; the
# app's Settings toggle then says so rather than failing.
#
# Immich's own ML container already does semantic search and face grouping, so
# this is an extra, not a replacement — see for-human.md before enabling it, as
# moondream wants about 2 GB of RAM on a machine that is already busy.
#
# There is no Laya service in docker-compose.yml yet: its container story is
# unresolved. See the comment there. Without it the cull queue still works and
# the album suggestion row simply does not render.

# Same compose stack, so these resolve by service name as written.
# AGENT_OLLAMA_URL=http://ollama:11434
# AGENT_LAYLA_URL=http://layla:8080

# Immich is in the *other* compose stack, so this one has no service name to
# assume. Pick whichever matches how you run it:
#   - if the agent joins the filesynapse network:
#       AGENT_IMMICH_URL=http://immich-server:2283
#   - otherwise, the host's own Tailscale address:
#       AGENT_IMMICH_URL=http://filesynapse:2283
AGENT_IMMICH_URL=

# The same all-scoped Immich key the desktop app uses (see for-human.md §6 — a
# narrower-scoped key returns 403 from every metadata route).
AGENT_IMMICH_API_KEY=

# AGENT_VISION_MODEL=moondream
# Photos scored per request. The client loops until the queue drains, so this is
# a patience setting rather than a limit. Keep it small on a slow CPU.
# AGENT_DECISION_BATCH=8
